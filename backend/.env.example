# ==============================================================================
# SJewls Configuration & Supabase Connection
# ==============================================================================

# Supabase PostgreSQL Database Connection String
# You can find this in your Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=Require
ConnectionStrings__DefaultConnection="Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.[YOUR-PROJECT-REF];Password=[YOUR-PASSWORD];SslMode=Require;Trust Server Certificate=true"

# Supabase Storage & API Details
Supabase__Url="https://[YOUR-PROJECT-REF].supabase.co"
Supabase__ServiceKey="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
Supabase__BucketName="sjewls-media"

# JWT Authentication for Staff & Customers
Jwt__Secret="super-secret-key-that-must-be-at-least-32-characters-long-sjewls-dev"
Jwt__Issuer="SJewls.Api"
Jwt__Audience="SJewls.App"
Jwt__ExpiryMinutes="1440"

# Application Settings
App__Environment="Development"
App__DefaultBranchCode="JAF-01"

# Development OTP Configuration (DO NOT enable in Production)
# Real delivery is default. Enable only in local development/staging for allowlisted test contacts.
Otp__EnableDevMode="false"
Otp__DevCode="[YOUR-DEV-OTP-CODE-e.g.-123456]"
Otp__AllowedTestContacts="[COMMA-SEPARATED-ALLOWLISTED-CONTACTS-e.g.-+94771234567,dev@example.com]"

# Email Delivery Configuration (Default: GmailApi via HTTPS REST API)
Email__Provider="GmailApi"
Email__FromAddress="w.sagee5@gmail.com"
Email__FromName="SJewls"
# Google OAuth2 Credentials for Gmail API (Refresh token must belong to w.sagee5@gmail.com)
Email__GmailClientId="[YOUR-GOOGLE-OAUTH-CLIENT-ID]"
Email__GmailClientSecret="[YOUR-GOOGLE-OAUTH-CLIENT-SECRET]"
Email__GmailRefreshToken="[YOUR-GOOGLE-OAUTH-REFRESH-TOKEN-FOR-w.sagee5@gmail.com]"
# Optional SMTP configuration (only needed if Email__Provider is set to "Smtp")
Email__Host="smtp.gmail.com"
Email__Port="587"
Email__Username="w.sagee5@gmail.com"
Email__Password="[YOUR-GMAIL-APP-PASSWORD]"

# Text.lk SMS Gateway Configuration for Real SMS OTP Delivery
Sms__Provider="TextLk"
Sms__ApiUrl="https://app.text.lk/api/v3/sms/send"
Sms__ApiToken="[YOUR-TEXT-LK-API-TOKEN]"
Sms__SenderId="TextLKDemo"


