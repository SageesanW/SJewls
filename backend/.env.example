# ==============================================================================
# SJewls Configuration & Supabase Connection
# ==============================================================================

# Supabase PostgreSQL Database Connection String
# You can find this in your Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=Require
ConnectionStrings__DefaultConnection="Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.[YOUR-PROJECT-REF];Password=[YOUR-PASSWORD];SslMode=Require;Trust Server Certificate=true"

# Supabase Storage & API Details
Supabase__Url="https://[YOUR-PROJECT-REF].supabase.co"
Supabase__ServiceKey="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
Supabase__BucketName="sjewls-media"

# JWT Authentication for Staff & Customers
Jwt__Secret="super-secret-key-that-must-be-at-least-32-characters-long-sjewls-dev"
Jwt__Issuer="SJewls.Api"
Jwt__Audience="SJewls.App"
Jwt__ExpiryMinutes="1440"

# Application Settings
App__Environment="Development"
App__DefaultBranchCode="JAF-01"
App__TestOtp="123456"
